#!/bin/sh
set -eu

PLUGIN_DIR="${1:-}"

absolute_executable() {
  candidate="$1"
  [ -x "$candidate" ] || return 1
  case "$candidate" in
    /*) printf '%s\n' "$candidate" ;;
    *)
      directory="$(dirname "$candidate")"
      filename="$(basename "$candidate")"
      directory="$(cd "$directory" 2>/dev/null && pwd -P)" || return 1
      printf '%s/%s\n' "$directory" "$filename"
      ;;
  esac
}

PATH_CANDIDATE="$(command -v yokai 2>/dev/null || true)"
if [ -n "$PATH_CANDIDATE" ] && absolute_executable "$PATH_CANDIDATE"; then exit 0; fi

if [ -n "$PLUGIN_DIR" ] && absolute_executable "$PLUGIN_DIR/bin/yokai"; then exit 0; fi

if [ -n "${HOME:-}" ] && absolute_executable "${HOME}/.local/bin/yokai"; then exit 0; fi

exit 1
